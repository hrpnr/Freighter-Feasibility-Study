{
  "name": "freighter-planner-frontend",
  "version": "1.0.0",
  "description": "Freighter Profitability Planner - Frontend",
  "main": "electron.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && npx electron .\"",
    "electron-build": "npm run build && electron-builder"
  },
  "keywords": [
    "freighter",
    "airline",
    "profitability",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-table": "^8.11.2",
    "axios": "^1.6.2",
    "date-fns": "^3.0.6",
    "lucide-react": "^1.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.10"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.freighterplanner.app",
    "productName": "Freighter Planner",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
